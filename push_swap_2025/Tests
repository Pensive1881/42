//		Error management tests (must print Error on stderr)

./push_swap a 2 3
./push_swap 1 2 2
./push_swap 2147483648
./push_swap -2147483649
./push_swap "1 2 a"
./push_swap "1 2 2"
./push_swap ""

./push_swap 1 2 2 1>/dev/null
echo $?
		You should still see Error (because it’s on fd 2) and $? should be 1: error_exit() does exit(1)



